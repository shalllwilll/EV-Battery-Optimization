# optional settings (no secrets needed)
EV_ALLOWED_ORIGINS=http://localhost:5173
EV_MAX_BODY_BYTES=1000000

# demo login (local demos only; set your own values for anything shared)
EV_AUTH_REQUIRED=true
EV_DEMO_USER=demo
EV_DEMO_PASSWORD=PackHorizon-2026
# If unset, each server process uses its own random key (sign-ins end on restart). Set it when running more than one worker.
EV_AUTH_SECRET=change-me-to-a-long-random-string

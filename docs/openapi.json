        "required": [
          "months_p10",
          "months_p50",
          "months_p90",
          "probability_by_month",
          "probability_within_horizon",
          "calendar_share_of_loss",
          "retention_p10",
          "retention_p50",
          "retention_p90",
          "months",
          "threshold",
          "extrapolated",
          "extrapolation_reasons",
          "warnings"
        ],
        "title": "ReplacementResult",
        "type": "object"
      },
      "Scenario": {
        "additionalProperties": false,
        "properties": {
          "archetype": {
            "default": "12m",
            "enum": [
              "12m",
              "9m"
            ],
            "title": "Archetype",
            "type": "string"
          },
          "battery_cost_per_kwh_inr": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Battery Cost Per Kwh Inr"
          },
          "charge_power_kw": {
            "exclusiveMinimum": 1.0,
            "maximum": 500.0,
            "title": "Charge Power Kw",
            "type": "number"
          },
          "charge_start_hour": {
            "default": 22.0,
            "exclusiveMaximum": 24.0,
            "minimum": 0.0,
            "title": "Charge Start Hour",
            "type": "number"
          },
          "departure_hour": {
            "default": 5.0,
            "exclusiveMaximum": 24.0,
            "minimum": 0.0,
            "title": "Departure Hour",
            "type": "number"
          },
          "heat_rise_c": {
            "default": 3.0,
            "description": "ASSUMED average cell temperature above ambient",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Heat Rise C",
            "type": "number"
          },
          "horizon_years": {
            "default": 15,
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Horizon Years",
            "type": "integer"
          },
          "km_per_day": {
            "exclusiveMinimum": 0.0,
            "maximum": 700.0,
            "title": "Km Per Day",
            "type": "number"
          },
          "kwh_per_km": {
            "exclusiveMinimum": 0.2,
            "maximum": 3.0,
            "title": "Kwh Per Km",
            "type": "number"
          },
          "operating_days_per_year": {
            "exclusiveMinimum": 50.0,
            "maximum": 366.0,
            "title": "Operating Days Per Year",
            "type": "number"
          },
          "pack_kwh": {
            "description": "nominal pack energy, kWh",
            "exclusiveMinimum": 20.0,
            "maximum": 700.0,
            "title": "Pack Kwh",
            "type": "number"
          },
          "pack_penalty_max": {
            "default": 0.08,
            "maximum": 0.5,
            "minimum": 0.0,
            "title": "Pack Penalty Max",
            "type": "number"
          },
          "pack_penalty_min": {
            "default": 0.0,
            "description": "ASSUMED weakest-cell earlier-end-of-life fraction",
            "maximum": 0.5,
            "minimum": 0.0,
            "title": "Pack Penalty Min",
            "type": "number"
          },
          "soc_max_pct": {
            "default": 100.0,
            "maximum": 100.0,
            "minimum": 40.0,
            "title": "Soc Max Pct",
            "type": "number"
          },
          "soc_min_pct": {
            "default": 10.0,
            "maximum": 60.0,
            "minimum": 0.0,
            "title": "Soc Min Pct",
            "type": "number"
          },
          "threshold": {
            "default": 0.8,
            "description": "replace when retention falls to this",
            "exclusiveMaximum": 0.95,
            "exclusiveMinimum": 0.5,
            "title": "Threshold",
            "type": "number"
          },
          "zone": {
            "default": "hot_dry",
            "enum": [
              "hot_dry",
              "hot_humid",
              "composite",
              "cool"

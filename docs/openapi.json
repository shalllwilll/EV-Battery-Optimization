          "seed": {
            "default": 0,
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          }
        },
        "required": [
          "scenario"
        ],
        "title": "PredictRequest",
        "type": "object"
      },

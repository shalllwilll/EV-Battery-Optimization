          },
          "retention_p50": {
            "$ref": "#/components/schemas/Labelled"
          },
          "retention_p90": {
            "$ref": "#/components/schemas/Labelled"
          },
          "threshold": {
            "$ref": "#/components/schemas/Labelled"

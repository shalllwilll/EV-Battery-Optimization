            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Labelled": {
        "description": "A number (or list of numbers) with its unit and what it rests on.\n\nlab        = fitted on public laboratory data (never validated on buses)\nassumption = a scenario input or default with no data behind it for buses\nderived    = computed from the above; inherits the weakest evidence of its inputs",
        "properties": {
          "evidence_level": {
            "enum": [
              "lab",
              "assumption",
              "derived"
            ],
            "title": "Evidence Level",
            "type": "string"
          },
          "note": {
            "default": "",
            "title": "Note",
            "type": "string"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "validated_on_buses": {
            "const": false,
            "default": false,
            "title": "Validated On Buses",
            "type": "boolean"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "value",
          "unit",
          "evidence_level"
        ],
        "title": "Labelled",
        "type": "object"
      },
      "PredictRequest": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "default": "prior",
            "description": "Only 'prior' exists in v1; anything else gets a 400",
            "title": "Mode",
            "type": "string"
          },
          "n_draws": {
            "default": 2000,
            "description": "Monte Carlo draws; fixed seed makes results repeatable",
            "maximum": 5000.0,
            "minimum": 200.0,
            "title": "N Draws",
            "type": "integer"
          },
          "range_temperature_mode": {
            "default": "none",

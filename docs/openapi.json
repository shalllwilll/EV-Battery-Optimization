  "info": {
    "description": "Prior mode only: models trained on public lab data, scenario inputs are assumptions, nothing is validated on buses.",
    "title": "E-bus battery lifecycle tool",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/compare": {
      "post": {
        "operationId": "compare_api_v1_compare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Paired what-if comparison of 2-4 scenarios on shared random draws",
        "tags": [
          "predict"
        ]
      }
    },
    "/api/v1/evidence": {
      "get": {
        "operationId": "get_evidence_api_v1_evidence_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Datasets, measured model errors, training coverage and known limitations",
        "tags": [
          "reference"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/v1/predict": {
      "post": {
        "operationId": "predict_api_v1_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Forecast battery retention, replacement window, range and cost per km for one scenario",
        "tags": [
          "predict"
        ]
      }
    },
    "/api/v1/presets": {
      "get": {
        "operationId": "get_presets_api_v1_presets_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}

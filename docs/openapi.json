      "CompareRequest": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "default": "prior",
            "description": "Only 'prior' exists in v1; anything else gets a 400",
            "title": "Mode",
            "type": "string"
          },
          "n_draws": {
            "default": 2000,
            "maximum": 5000.0,
            "minimum": 200.0,
            "title": "N Draws",
            "type": "integer"
          },
          "scenarios": {
            "description": "first scenario is the base; the rest are variants",
            "items": {
              "$ref": "#/components/schemas/Scenario"
            },
            "maxItems": 4,
            "minItems": 2,
            "title": "Scenarios",
            "type": "array"
          },
          "seed": {
            "default": 0,
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          }
        },
        "required": [
          "scenarios"
        ],
        "title": "CompareRequest",
        "type": "object"
      },
      "CompareResult": {
        "properties": {
          "deltas": {
            "description": "variant minus base, one per variant (months to threshold)",
            "items": {
              "$ref": "#/components/schemas/Delta"
            },
            "title": "Deltas",
            "type": "array"
          },
          "disclaimer": {
            "default": "Prior mode: models are fitted on public laboratory cell data and scenario inputs are assumptions. Nothing here has been validated on buses.",
            "title": "Disclaimer",
            "type": "string"
          },
          "mode": {
            "const": "prior",
            "default": "prior",
            "title": "Mode",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "title": "Notes",
            "type": "array"
          },
          "replacements": {
            "description": "aligned with `scenarios`; computed on shared random draws",
            "items": {
              "$ref": "#/components/schemas/ReplacementResult"
            },
            "title": "Replacements",
            "type": "array"
          },
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/Scenario"
            },
            "title": "Scenarios",
            "type": "array"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "model_version",
          "scenarios",
          "replacements",
          "deltas",
          "notes",
          "warnings"
        ],
        "title": "CompareResult",
        "type": "object"
      },
      "CostResult": {
